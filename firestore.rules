rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agam PG Management - Allow read/write for all PG management operational data
    match /rooms/{roomId} {
      allow read, write: if true;
    }
    match /tenants/{tenantId} {
      allow read, write: if true;
    }
    match /payments/{paymentId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /corporateGroups/{groupId} {
      allow read, write: if true;
    }
    match /meta/{docId} {
      allow read, write: if true;
    }
  }
}
